# =================================================================
# AI Interview Prep Kit - Environment Configuration
# =================================================================

# Server Settings
PORT=5000
NODE_ENV=development

# Database Settings
# Optional for local evaluation/testing: If omitted, an embedded in-memory database will be used automatically.
MONGODB_URI=mongodb://localhost:27017/ai_interview_prep

# Authentication
JWT_SECRET=super-secret-jwt-token-replace-in-production-min32chars!

# LLM Providers (Genuine Free Tiers - At least one recommended)
# 1. Google Gemini API (Free tier from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq API (High-speed free tier from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Active LLM Provider: 'gemini' | 'groq' | 'mock'
# If left empty, system automatically picks the provider matching whichever API key is configured.
# If no key is configured, it falls back to deterministic mock pipeline for automated testing and offline evaluation.
LLM_PROVIDER=

# Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
